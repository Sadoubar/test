{
  "name": "billing-app",
  "version": "1.0.0",
  "description": "Application de facturation professionnelle",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint server/**/*.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop billing-app",
    "pm2:restart": "pm2 restart billing-app",
    "pm2:logs": "pm2 logs billing-app",
    "docker:build": "docker build -t billing-app .",
    "docker:run": "docker run -p 3000:3000 billing-app"
  },
  "keywords": ["billing", "invoicing", "facturation", "production-ready"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "sqlite3": "^5.1.6",
    "body-parser": "^1.20.2",
    "pdfkit": "^0.13.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "pm2": "^5.3.0"
  }
}
